{
  "manifest_version": 3,
  "name": "hb session bridge",
  "version": "0.1.0",
  "description": "Send your logged-in red-packet site session to the local hb CLI. Talks to 127.0.0.1 only.",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://hb.lafi.sh/*",
    "https://credit.linux.do/*",
    "https://hb.unsnow.org/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "hb"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hb-session-bridge@local",
      "strict_min_version": "121.0"
    }
  }
}
